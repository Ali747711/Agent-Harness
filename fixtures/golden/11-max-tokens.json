{
  "summary": [
    "session_started",
    "turn_started",
    "assistant_text_delta \"partial output\"",
    "turn_completed max_tokens",
    "error error max_tokens",
    "session_idle"
  ],
  "events": [
    {
      "type": "session_started",
      "sessionId": "golden-session",
      "protocolVersion": 1,
      "model": "claude-opus-5",
      "workspaceRoot": "<WS>",
      "memoryFiles": []
    },
    {
      "type": "turn_started",
      "turn": 1
    },
    {
      "type": "assistant_text_delta",
      "text": "partial output"
    },
    {
      "type": "turn_completed",
      "stopReason": "max_tokens",
      "usage": {
        "inputTokens": 100,
        "outputTokens": 20,
        "cacheReadInputTokens": 0,
        "cacheCreationInputTokens": 0
      },
      "costUsd": 0.001
    },
    {
      "type": "error",
      "severity": "error",
      "code": "max_tokens",
      "message": "output hit maxTokens (32000); raise --max-tokens and retry",
      "recoverable": true
    },
    {
      "type": "session_idle"
    }
  ]
}